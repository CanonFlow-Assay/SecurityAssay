<Project>
  <Target Name="RequirePinnedNativeToolchain" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="'$(NETCoreSdkVersion)' != '11.0.100' or '$(TargetFramework)' != 'net11.0' or '$(TargetFrameworks)' != '' or '$(LangVersion)' != '15.0' or '$(Nullable)' != 'enable' or '$(TreatWarningsAsErrors)' != 'true'"
           Code="SECURITYASSAY-NATIVE-PIN-REQUIRED" Text="Exact .NET 11 SDK, net11.0, C# 15, nullable and warnings-as-errors are mandatory." />
  </Target>
</Project>
